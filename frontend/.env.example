# Copy to .env.local for local dev. Production values live in Vercel env.
# Backend selector: "fastapi" (same-origin / local uvicorn) or "gradio" (split hosting).
VITE_BACKEND=fastapi

# FastAPI mode: "" = same origin; "http://localhost:7860" also works (vite proxies /api).
VITE_API_URL=

# Gradio (split) mode:
# VITE_BACKEND=gradio
# VITE_GRADIO_URL=https://Ashish-04007-signal-lab-voice-detector.hf.space
# VITE_THRESHOLD=0.85
